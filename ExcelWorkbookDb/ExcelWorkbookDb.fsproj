<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <NuGetAudit>false</NuGetAudit>
    <TargetFramework>netstandard2.0</TargetFramework>
    <OutputType>Library</OutputType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Excel 工作簿 SQLite 数据库访问包装库（netstandard2.0，不依赖 Excel 互操作）。</Description>
    <Authors>xp44m</Authors>
    <Company>34696643@qq.com</Company>
    <Copyright>xp44mm</Copyright>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/xp44mm/ExcelVSTO</RepositoryUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <AssemblyVersion></AssemblyVersion>
    <FileVersion></FileVersion>
    <Version>1.1.0</Version>
    <PackageReleaseNotes>1.1.0：CellRow 增加 getLocalAdress/FullAdress 地址计算，FullAdress 按 Excel 规则为工作表名自动加引号；契约收紧：Workbook 表恒有一行且名称非空，WorkbookData.Name 由 string option 改为 string，createDatabase 增加 name 参数，setWorkbookName 拒绝空名称，读取空表报错。</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/xp44mm/ExcelVSTO</PackageProjectUrl>
    <PackageTags>sqlite;excel;fsharp;workbook</PackageTags>
    <PackageReadmeFile>readme.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="create_excel_db.sql" LogicalName="ExcelWorkbookDb.create_excel_db.sql" />
    <Compile Include="WorkbookDb.fs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\readme.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Stub.System.Data.SQLite.Core.NetStandard" Version="1.0.119" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="10.1.401" />
  </ItemGroup>
</Project>
